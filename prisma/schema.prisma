// =====================================
// Prisma Schema — O'quv Markaz Online LMS Backend
// Online ta'lim platformasi: kurslar, video darslar, enrollment,
// progress, sertifikatlar, sharhlar va online to'lovlar.
// =====================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// ENUMS
// =====================================

enum UserRole {
  super_admin
  admin
  instructor
  student
}

enum UserStatus {
  active
  inactive
  banned
}

enum Gender {
  male
  female
}

enum StudentStatus {
  active
  inactive
  graduated
}

enum InstructorStatus {
  active
  inactive
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  active
  archived
}

enum EnrollmentStatus {
  active
  completed
  refunded
  cancelled
}

enum PaymentMethod {
  payme
  click
  card
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum CertificateStatus {
  issued
  revoked
}

enum BlogStatus {
  draft
  published
  archived
}

enum CommentStatus {
  pending
  approved
  rejected
}

enum ContactStatus {
  new
  read
  replied
}

// =====================================
// USERS
// =====================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  phone           String     @unique
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(student)
  status          UserStatus @default(active)
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  middleName      String?    @map("middle_name")
  birthDate       DateTime?  @map("birth_date") @db.Date
  gender          Gender?
  address         String?
  avatarUrl       String?    @map("avatar_url")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  // Relations
  student            Student?
  instructor         Instructor?
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  blogPosts          BlogPost[]               @relation("blog_author")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Student {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @unique @map("user_id") @db.Uuid
  studentId  String        @unique @map("student_id") // ST-0123
  enrolledAt DateTime      @default(now()) @map("enrolled_at") // platformaga ro'yxatdan o'tgan sana
  status     StudentStatus @default(active)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  progress     LessonProgress[]
  certificates Certificate[]
  reviews      Review[]
  payments     Payment[]

  @@index([studentId])
  @@map("students")
}

// O'qituvchi = kurs muallifi (online instructor)
model Instructor {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @unique @map("user_id") @db.Uuid
  instructorId String           @unique @map("instructor_id") // IN-001
  specialty    String // "JavaScript / Frontend"
  experience   Int              @default(0) // yillar
  bio          String?
  rating       Decimal          @default(0) @db.Decimal(3, 2)
  socialLinks  Json?            @map("social_links") // {github, linkedin, telegram}
  status       InstructorStatus @default(active)
  createdAt    DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([instructorId])
  @@map("instructors")
}

// =====================================
// SESSIONS + AUTH TOKENS
// =====================================

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  device       String?
  refreshToken String   @unique @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

// =====================================
// COURSES (online kurslar)
// =====================================

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  description     String       @db.Text
  longDescription String       @map("long_description") @db.Text
  category        String
  level           CourseLevel  @default(beginner)
  price           Decimal      @default(0) @db.Decimal(15, 2)
  oldPrice        Decimal?     @map("old_price") @db.Decimal(15, 2)
  durationMonths  Int          @default(1) @map("duration_months")
  lessonsCount    Int          @default(0) @map("lessons_count")
  studentsCount   Int          @default(0) @map("students_count") // cached enrollment soni
  imageUrl        String?      @map("image_url")
  previewVideoUrl String?      @map("preview_video_url")
  isFeatured      Boolean      @default(false) @map("is_featured")
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount     Int          @default(0) @map("rating_count")
  status          CourseStatus @default(draft)
  instructorId    String?      @map("instructor_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  instructor   Instructor?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]
  payments     Payment[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([isFeatured])
  @@index([instructorId])
  @@map("courses")
}

model CourseModule {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  title    String
  order    Int    @default(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id              String  @id @default(uuid()) @db.Uuid
  moduleId        String  @map("module_id") @db.Uuid
  title           String
  durationMinutes Int     @default(0) @map("duration_minutes")
  order           Int     @default(0)
  videoUrl        String? @map("video_url")
  content         String? @db.Text // dars matni / tavsifi
  isPreview       Boolean @default(false) @map("is_preview") // bepul ko'rish mumkin

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

// =====================================
// ENROLLMENT (talaba kursga yozilgan / sotib olgan)
// =====================================

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  status      EnrollmentStatus @default(active)
  progress    Int              @default(0) // 0-100 cached %
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  lastViewedLessonId String?   @map("last_viewed_lesson_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

// =====================================
// LESSON PROGRESS (har bir dars bo'yicha talaba holati)
// =====================================

model LessonProgress {
  id             String    @id @default(uuid()) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  lessonId       String    @map("lesson_id") @db.Uuid
  completed      Boolean   @default(false)
  watchedSeconds Int       @default(0) @map("watched_seconds")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// =====================================
// CERTIFICATES (kurs tugatilganda)
// =====================================

model Certificate {
  id        String            @id @default(uuid()) @db.Uuid
  studentId String            @map("student_id") @db.Uuid
  courseId  String            @map("course_id") @db.Uuid
  serialNo  String            @unique @map("serial_no") // CERT-2026-0001
  status    CertificateStatus @default(issued)
  url       String? // PDF havola
  issuedAt  DateTime          @default(now()) @map("issued_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("certificates")
}

// =====================================
// REVIEWS (kurs sharhlari)
// =====================================

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  courseId  String       @map("course_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  rating    Int // 1-5
  text      String?      @db.Text
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@map("reviews")
}

// =====================================
// PAYMENTS (online kurs xaridi)
// =====================================

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  courseId      String        @map("course_id") @db.Uuid
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  transactionId String?       @map("transaction_id")
  receiptUrl    String?       @map("receipt_url")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// =====================================
// BLOG (public kontent)
// =====================================

model BlogCategory {
  id    String     @id @default(uuid()) @db.Uuid
  name  String
  slug  String     @unique
  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  slug        String     @unique
  excerpt     String     @db.Text
  content     String     @db.Text
  imageUrl    String?    @map("image_url")
  authorId    String?    @map("author_id") @db.Uuid
  categoryId  String?    @map("category_id") @db.Uuid
  viewsCount  Int        @default(0) @map("views_count")
  readMinutes Int        @default(5) @map("read_minutes")
  isFeatured  Boolean    @default(false) @map("is_featured")
  status      BlogStatus @default(draft)
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author   User?         @relation("blog_author", fields: [authorId], references: [id], onDelete: SetNull)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments BlogComment[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@map("blog_posts")
}

model BlogComment {
  id          String        @id @default(uuid()) @db.Uuid
  postId      String        @map("post_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  authorName  String        @map("author_name")
  authorEmail String        @map("author_email")
  text        String        @db.Text
  status      CommentStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at")

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  BlogComment?  @relation("comment_thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlogComment[] @relation("comment_thread")

  @@index([postId])
  @@index([status])
  @@map("blog_comments")
}

// =====================================
// CONTACT (aloqa formasi)
// =====================================

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("contact_messages")
}
